<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in backups: the list of computers is easy to add again. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root"/><exclude domain="file"/><exclude domain="database"/><exclude domain="sharedpref"/></cloud-backup>
    <device-transfer><exclude domain="root"/></device-transfer>
</data-extraction-rules>
